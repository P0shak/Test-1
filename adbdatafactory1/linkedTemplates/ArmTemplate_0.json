						"precision": 10
					},
					{
						"name": "unit_price",
						"type": "decimal",
						"precision": 18,
						"scale": 2
					},
					{
						"name": "sales_channel",
						"type": "varchar"
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "customers"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDatabase1')]"
			]
		},
