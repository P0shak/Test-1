{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_json_to_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable2",
						"type": "DatasetReference"
					},
					"name": "green"
				}
			],
			"transformations": [
				{
					"name": "cast1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as string,",
				"          firstName as string,",
				"          lastName as string,",
				"          maidenName as string,",
				"          age as string,",
				"          gender as string,",
				"          email as string,",
				"          phone as string,",
				"          username as string,",
				"          password as string,",
				"          birthDate as string,",
				"          image as string,",
				"          bloodGroup as string,",
				"          height as string,",
				"          weight as string,",
				"          eyeColor as string,",
				"          color as string,",
				"          type as string,",
				"          ip as string,",
				"          {users'][0]['address_address} as string,",
				"          {users'][0]['address_city} as string,",
				"          {users'][0]['address_state} as string,",
				"          {users'][0]['address_stateCode} as string,",
				"          {users'][0]['address_postalCode} as string,",
				"          {users'][0]['address_coordinates_lat} as string,",
				"          {users'][0]['address_coordinates_lng} as string,",
				"          {users'][0]['address_country} as string,",
				"          macAddress as string,",
				"          university as string,",
				"          cardExpire as string,",
				"          cardNumber as string,",
				"          cardType as string,",
				"          currency as string,",
				"          iban as string,",
				"          department as string,",
				"          name as string,",
				"          title as string,",
				"          {users'][0]['company_address_address} as string,",
				"          {users'][0]['company_address_city} as string,",
				"          {users'][0]['company_address_state} as string,",
				"          {users'][0]['company_address_stateCode} as string,",
				"          {users'][0]['company_address_postalCode} as string,",
				"          {users'][0]['company_address_coordinates_lat} as string,",
				"          {users'][0]['company_address_coordinates_lng} as string,",
				"          {users'][0]['company_address_country} as string,",
				"          ein as string,",
				"          ssn as string,",
				"          userAgent as string,",
				"          coin as string,",
				"          wallet as string,",
				"          network as string,",
				"          role as string,",
				"          total as string,",
				"          skip as string,",
				"          limit as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 cast(output(",
				"          id as integer,",
				"          firstName as string,",
				"          lastName as string,",
				"          maidenName as string,",
				"          age as integer,",
				"          gender as string,",
				"          email as string,",
				"          phone as string,",
				"          username as string,",
				"          password as string,",
				"          birthDate as string,",
				"          image as string,",
				"          bloodGroup as string,",
				"          height as double,",
				"          weight as double,",
				"          eyeColor as string,",
				"          color as string,",
				"          type as string,",
				"          ip as string,",
				"          {users'][0]['address_address} as string,",
				"          {users'][0]['address_city} as string,",
				"          {users'][0]['address_state} as string,",
				"          {users'][0]['address_stateCode} as string,",
				"          {users'][0]['address_postalCode} as integer,",
				"          {users'][0]['address_coordinates_lat} as double,",
				"          {users'][0]['address_coordinates_lng} as double,",
				"          {users'][0]['address_country} as string,",
				"          macAddress as string,",
				"          university as string,",
				"          cardExpire as string,",
				"          cardNumber as string,",
				"          cardType as string,",
				"          currency as string,",
				"          iban as string,",
				"          department as string,",
				"          name as string,",
				"          title as string,",
				"          {users'][0]['company_address_address} as string,",
				"          {users'][0]['company_address_city} as string,",
				"          {users'][0]['company_address_state} as string,",
				"          {users'][0]['company_address_stateCode} as string,",
				"          {users'][0]['company_address_postalCode} as integer,",
				"          {users'][0]['company_address_coordinates_lat} as double,",
				"          {users'][0]['company_address_coordinates_lng} as double,",
				"          {users'][0]['company_address_country} as string,",
				"          ein as string,",
				"          ssn as string,",
				"          userAgent as string,",
				"          coin as string,",
				"          wallet as string,",
				"          network as string,",
				"          role as string,",
				"          total as integer,",
				"          skip as integer,",
				"          limit as integer",
				"     ),",
				"     errors: true) ~> cast1",
				"cast1 split(eyeColor=='Green',",
				"     eyeColor=='Brown',",
				"     eyeColor=='Blue',",
				"     eyeColor=='Hazel',",
				"     disjoint: false) ~> split1@(Green, Brown, Blue, Hazel)",
				"split1@Green sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> green"
			]
		}
	}
}